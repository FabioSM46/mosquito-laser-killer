    {
      "id": "ms7cqbd806f8lzxd0gop",
      "type": "text",
      "x": 348,
      "y": 214,
      "strokeColor": "#868e96",
      "text": "1 of 4 channels used",
      "fontSize": 10,
      "fontFamily": 2,
