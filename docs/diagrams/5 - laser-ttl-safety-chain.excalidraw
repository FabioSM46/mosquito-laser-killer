      "version": 1
    },
    {
      "id": "ms7cqbd8qq4l7boegj",
      "type": "text",
      "x": 348,
      "y": 238,
      "strokeColor": "#1e1e1e",
      "text": " 2  1A  ← GPIO 18\n 3  1Y  → fire line\n 1  /OE → GND\n14  VCC → +5 V\n 7  GND → common\n\nunused  5,9,12 (A)  → GND\n        4,10,13 (/OE)→ GND\n        6,8,11 (Y)  → open\n100 nF across 14 ↔ 7",
      "fontSize": 12,
      "fontFamily": 3,
      "createdAt": "2026-07-30T10:09:21.936Z",
      "updatedAt": "2026-07-30T10:09:21.936Z",
      "version": 1
    },
