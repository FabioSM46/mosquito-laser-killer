      "version": 1
    },
    {
      "id": "ms7cqbd9gzw0nn9napq",
      "type": "text",
      "x": 1108,
      "y": 536,
      "strokeColor": "#1e1e1e",
      "text": " 1  1A ← fire line\n 2  1B ← 74HC123 pin 13 (1Q)\n 3  1Y → laser-driver TTL pin\n14  VCC → +5 V     7  GND → common\n\nunused gates: tie every input to a\ndefined level, leave outputs open\n100 nF ceramic across 14 ↔ 7",
      "fontSize": 12,
      "fontFamily": 3,
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
