  "elements": [
    {
      "id": "ms7cqbd8ibgb2kfgr6",
      "type": "text",
      "x": 40,
      "y": 24,
      "strokeColor": "#1e1e1e",
      "text": "Laser TTL Safety Chain",
      "fontSize": 30,
      "fontFamily": 1,
      "createdAt": "2026-07-30T10:09:21.936Z",
      "updatedAt": "2026-07-30T10:09:21.936Z",
      "version": 1
    },
    {
      "id": "ms7cqbd8jbkks6cbffa",
      "type": "text",
      "x": 40,
      "y": 66,
      "strokeColor": "#6741d9",
      "text": "HARDWARE_WIRING.md §9.3, §11, §11a.   laser TTL  =  translated GPIO 18  ∧  74HC123 1Q",
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:09:21.936Z",
      "updatedAt": "2026-07-30T10:09:21.936Z",
      "version": 1
    },
    {
      "id": "ms7cqbd86lsb7ijtexs",
      "type": "text",
      "x": 40,
      "y": 90,
      "strokeColor": "#e03131",
      "text": "One sustained HIGH per pulse — NEVER PWM. Retriggering edges inside the one-shot window would hold Q HIGH indefinitely and defeat the duration cap.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:09:21.936Z",
      "updatedAt": "2026-07-30T10:09:21.936Z",
      "version": 1
    },
