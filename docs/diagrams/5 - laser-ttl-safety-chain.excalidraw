    {
      "id": "ms7cqbd9suc00x1shmb",
      "type": "text",
      "x": 666,
      "y": 737,
      "strokeColor": "#868e96",
      "text": "GND",
      "fontSize": 11,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ms7cqbd9vyffdp1uj79",
      "type": "text",
      "x": 700,
      "y": 664,
      "strokeColor": "#e03131",
      "text": "(b)  translator Hi-Z: unpowered,\n/OE high, or IC pulled from\nits socket — nothing else\ncovers this case",
      "fontSize": 11,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ic123",
      "type": "rectangle",
      "x": 700,
      "y": 180,
      "width": 352,
      "height": 310,
      "backgroundColor": "#d0bfff",
      "strokeColor": "#6741d9",
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ms7cqbd9h96pgzdyt59",
      "type": "text",
      "x": 718,
      "y": 192,
      "strokeColor": "#6741d9",
      "text": "74HC123  retriggerable one-shot",
      "fontSize": 14,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ms7cqbd9m22vbzmii",
      "type": "text",
      "x": 718,
      "y": 216,
      "strokeColor": "#1e1e1e",
      "text": " 1  1A        → GND  (required for the 1B\n                      rising edge to trigger)\n 2  1B        ← fire line   (+edge trigger)\n 3  1CLR/1RD  ← fire line   (resets while idle)\n13  1Q        → 74HC08 pin 2    ACTIVE HIGH\n 4  1Q-bar    → open            NOT this one\n16  VCC       → +5 V\n 8  GND       → common ground\n\nunused ch 2:  11 (2CLR) LOW\n              9,10 (2A,2B) to a defined level\n              6,7 (2Cext, 2Rext/Cext) open\n100 nF ceramic across 16 ↔ 8",
      "fontSize": 12,
      "fontFamily": 3,
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "tbox",
      "type": "rectangle",
      "x": 700,
      "y": 510,
      "width": 352,
      "height": 152,
      "backgroundColor": "#fff9db",
      "strokeColor": "#e8590c",
      "strokeStyle": "dashed",
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ms7cqbd9t5jb63ia0o",
      "type": "text",
      "x": 716,
      "y": 520,
      "strokeColor": "#e8590c",
      "text": "TIMING NETWORK — channel 1",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ms7cqbd9yz33dil6vwa",
      "type": "text",
      "x": 716,
      "y": 544,
      "strokeColor": "#1e1e1e",
      "text": "pin 14  1Rext/Cext ── 220 kΩ ──► +5 V\npin 15  1Cext ────── 1 µF ────── pin 14",
      "fontSize": 12,
      "fontFamily": 3,
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ms7cqbd9l6rnhhnfmbr",
      "type": "text",
      "x": 716,
      "y": 588,
      "strokeColor": "#e03131",
      "text": "The two channels are MIRRORED. Channel 2 is\n6 = 2Cext, 7 = 2Rext/Cext; channel 1 reverses it.\nThe 220 kΩ goes to PIN 14. On pin 15 it feeds the\ndischarge node and the measured period is meaningless.",
      "fontSize": 11,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ic08",
      "type": "rectangle",
      "x": 1090,
      "y": 500,
      "width": 320,
      "height": 190,
      "backgroundColor": "#d0bfff",
      "strokeColor": "#6741d9",
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-07-30T10:09:21.937Z",
      "updatedAt": "2026-07-30T10:09:21.937Z",
      "version": 1
    },
    {
      "id": "ms7cqbd9up9ur13u2m",
      "type": "text",
      "x": 1108,
      "y": 512,
      "strokeColor": "#6741d9",
      "text": "SN74HC08N  quad 2-input AND",
      "fontSize": 14,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:09:21.937Z",
