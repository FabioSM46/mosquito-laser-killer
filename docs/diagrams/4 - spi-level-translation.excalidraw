  "elements": [
    {
      "id": "ms7cnkv88lz232fkfjl",
      "type": "text",
      "x": 40,
      "y": 24,
      "strokeColor": "#1e1e1e",
      "text": "SPI Level Translation & MCP4922 DACs",
      "fontSize": 30,
      "fontFamily": 1,
      "createdAt": "2026-07-30T10:07:14.281Z",
      "updatedAt": "2026-07-30T10:07:14.281Z",
      "version": 1
    },
    {
      "id": "ms7cnkv8cdvkjiadnzw",
      "type": "text",
      "x": 40,
      "y": 66,
      "strokeColor": "#868e96",
      "text": "HARDWARE_WIRING.md §8, §9, §10.  Pin numbers are PDIP. Confirm every one against the manufacturer's datasheet before soldering.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:07:14.281Z",
      "updatedAt": "2026-07-30T10:07:14.281Z",
      "version": 1
    },
    {
      "id": "ms7cnkv8678wdtmafdg",
      "type": "text",
      "x": 40,
      "y": 86,
      "strokeColor": "#e03131",
      "text": "AHCT is load-bearing: AHC and HC are pin-identical but need 3.5 V and reproduce the exact problem this part solves.\nThe devices on hand carry a marketplace brand with NO manufacturer traceability, so the marking certifies nothing.\nQualify each one by the \u00a79.4 threshold test: the output must flip near 1.4\u20131.5 V, not near 2.5 V.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:07:14.281Z",
      "updatedAt": "2026-07-30T10:07:14.281Z",
      "version": 1
    },
    {
      "id": "pi",
      "type": "rectangle",
      "x": 40,
