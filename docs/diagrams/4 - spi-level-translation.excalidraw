    },
    {
      "id": "ms7cnkv96q90jpn3uth",
      "type": "text",
      "x": 538,
      "y": 182,
      "strokeColor": "#6741d9",
      "text": "SN74AHCT125N #1",
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "ms7cnkv90a1rfsc5zp25",
      "type": "text",
      "x": 538,
      "y": 204,
      "strokeColor": "#868e96",
      "text": "quad bus buffer · 4 of 4 channels used",
      "fontSize": 10,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "ms7cnkv9v1mont98i1a",
      "type": "text",
      "x": 538,
      "y": 228,
      "strokeColor": "#1e1e1e",
      "text": " 2  1A ← MOSI        3  1Y →\n 5  2A ← SCLK        6  2Y →\n 9  3A ← CE0         8  3Y →\n12  4A ← CE1        11  4Y →\n\n14  VCC  → +5 V\n 7  GND  → common ground\n 1,4,10,13  /OE → GND\n\n100 nF ceramic across 14 ↔ 7",
      "fontSize": 12,
      "fontFamily": 3,
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "ms7cnkv9f6tpg53arpa",
      "type": "text",
      "x": 538,
      "y": 452,
      "strokeColor": "#e03131",
      "text": "/OE tied LOW — not a laser enable (§9.3)",
      "fontSize": 10,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "dacx",
      "type": "rectangle",
      "x": 860,
      "y": 170,
      "width": 330,
      "height": 300,
      "backgroundColor": "#ffd8a8",
      "strokeColor": "#e8590c",
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "ms7cnkv9oodise35d0g",
      "type": "text",
      "x": 878,
      "y": 182,
      "strokeColor": "#e8590c",
      "text": "MCP4922 #1 — X axis",
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "ms7cnkv9lfqjxwpbq0q",
      "type": "text",
      "x": 878,
      "y": 210,
      "strokeColor": "#1e1e1e",
      "text": " 1  VDD    → +5 V\n 3  /CS    ← CE0 (translated)\n 4  SCK    ← SCLK (translated)\n 5  SDI    ← MOSI (translated)\n 8  /LDAC  → GND          ** required **\n 9  /SHDN  → +5 V         ** required **\n11  VREFB  → +5 V\n13  VREFA  → +5 V\n12  AVSS   → common ground\n14  VOUTA  → X driver IN+\n10  VOUTB  → X driver IN−\n 2,6,7  NC → leave open\n\n100 nF ceramic across 1 ↔ 12",
      "fontSize": 12,
      "fontFamily": 3,
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "dacy",
      "type": "rectangle",
      "x": 860,
      "y": 500,
      "width": 330,
      "height": 300,
      "backgroundColor": "#ffd8a8",
      "strokeColor": "#e8590c",
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "ms7cnkv9vb8hp103dw",
      "type": "text",
      "x": 878,
      "y": 512,
      "strokeColor": "#e8590c",
      "text": "MCP4922 #2 — Y axis",
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
    {
      "id": "ms7cnkv9ypg5w4uyala",
      "type": "text",
      "x": 878,
      "y": 540,
      "strokeColor": "#1e1e1e",
      "text": " 1  VDD    → +5 V\n 3  /CS    ← CE1 (translated)\n 4  SCK    ← SCLK (translated)\n 5  SDI    ← MOSI (translated)\n 8  /LDAC  → GND          ** required **\n 9  /SHDN  → +5 V         ** required **\n11  VREFB  → +5 V\n13  VREFA  → +5 V\n12  AVSS   → common ground\n14  VOUTA  → Y driver IN+\n10  VOUTB  → Y driver IN−\n 2,6,7  NC → leave open\n\n100 nF ceramic across 1 ↔ 12",
      "fontSize": 12,
      "fontFamily": 3,
      "createdAt": "2026-07-30T10:07:14.282Z",
      "updatedAt": "2026-07-30T10:07:14.282Z",
      "version": 1
    },
