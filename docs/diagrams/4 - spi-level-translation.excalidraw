    {
      "id": "ms7cnkv9i3z2mcfhh9",
      "type": "text",
      "x": 530,
      "y": 700,
      "strokeColor": "#868e96",
      "text": "MOSI and SCLK fan out to BOTH DACs.\nCE0 selects X, CE1 selects Y.",
