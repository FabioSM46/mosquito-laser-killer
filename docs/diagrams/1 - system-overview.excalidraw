    {
      "id": "pwr-note",
      "type": "text",
      "x": 1055,
      "y": 840,
      "strokeColor": "#1e1e1e",
      "text": "Both live conductors are switched: on a reversible\ninlet \"L\" is not reliably Live.\n\nK1 latches — closing the isolator energises nothing.\nSTART does, and it is the last step of power-up.",
      "fontSize": 12,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.430Z",
      "updatedAt": "2026-07-30T09:53:41.430Z",
      "version": 1
