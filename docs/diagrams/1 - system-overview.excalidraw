    {
      "id": "pi-note",
      "type": "text",
      "x": 40,
      "y": 325,
      "strokeColor": "#2f9e44",
      "text": "Pi 5: own USB-C 5 V supply — NOT on K1.\nIts header feeds the 5 V logic rail, so the\nfail-LOW pull-downs stay defined through\nan E-stop.",
      "fontSize": 11,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.428Z",
      "updatedAt": "2026-07-30T09:54:12.175Z",
      "version": 2,
      "originalText": "Pi 5: own USB-C 5 V supply — NOT on K1.\nIts header feeds the 5 V logic rail, so the\nfail-LOW pull-downs stay defined through\nan E-stop."
    },
