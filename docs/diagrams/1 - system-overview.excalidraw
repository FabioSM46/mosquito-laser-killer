    {
      "id": "lzone-cap1",
      "type": "text",
      "x": 510,
      "y": 328,
      "strokeColor": "#2f9e44",
      "text": "Hardware-bounded pulse duration — the one guard that does not need the control thread.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.428Z",
      "updatedAt": "2026-07-30T09:53:41.428Z",
      "version": 1
    },
    {
      "id": "lzone-cap2",
      "type": "text",
      "x": 510,
      "y": 350,
      "strokeColor": "#e03131",
      "text": "Software is still in the loop: GPIO 18 decides whether and when to fire. The 74HC123 only caps how long a stuck-HIGH can last.",
      "fontSize": 12,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.429Z",
      "updatedAt": "2026-07-30T09:53:41.429Z",
      "version": 1
    },
    {
      "id": "lzone-cap3",
      "type": "text",
      "x": 510,
      "y": 370,
      "strokeColor": "#868e96",
      "text": "One sustained HIGH per pulse — never PWM. Three 10 kΩ fail-LOW pull-downs: translator in, translator out, driver connector.",
      "fontSize": 12,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.429Z",
      "updatedAt": "2026-07-30T09:53:41.429Z",
      "version": 1
    },
    {
      "id": "sense-hint",
      "type": "text",
      "x": 388,
      "y": 470,
      "strokeColor": "#868e96",
      "text": "GPIO 24 / GPIO 25 sense",
      "fontSize": 12,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.429Z",
      "updatedAt": "2026-07-30T09:53:41.429Z",
      "version": 1
    },
