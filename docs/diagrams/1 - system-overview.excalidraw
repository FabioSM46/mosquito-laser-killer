    },
    {
      "id": "door",
      "type": "rectangle",
      "x": 60,
      "y": 655,
      "width": 200,
      "height": 52,
      "backgroundColor": "#ffec99",
      "strokeColor": "#f08c00",
      "label": {
        "text": "DOOR interlock"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-07-30T09:53:41.429Z",
      "updatedAt": "2026-07-30T09:53:41.429Z",
      "version": 1
    },
    {
      "id": "door-txt",
      "type": "text",
      "x": 286,
      "y": 653,
      "strokeColor": "#1e1e1e",
      "text": "contact 1 → drops K1, removing ±15 V and 12 V\ncontact 2 → cuts laser 12 V directly; reads as a disarm on GPIO 24",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.429Z",
      "updatedAt": "2026-07-30T09:53:41.429Z",
      "version": 1
    },
    {
      "id": "estop",
      "type": "rectangle",
      "x": 60,
      "y": 722,
      "width": 200,
      "height": 52,
      "backgroundColor": "#ffc9c9",
      "strokeColor": "#e03131",
      "label": {
        "text": "E-STOP"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-07-30T09:53:41.429Z",
      "updatedAt": "2026-07-30T09:53:41.429Z",
      "version": 1
    },
    {
      "id": "estop-txt",
      "type": "text",
      "x": 286,
      "y": 720,
      "strokeColor": "#1e1e1e",
      "text": "pole 1 → drops the K1 coil.  Releasing it does NOT restart — START is required.\npole 2 → GPIO 25 active-LOW sense",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.429Z",
      "updatedAt": "2026-07-30T09:53:41.429Z",
      "version": 1
    },
