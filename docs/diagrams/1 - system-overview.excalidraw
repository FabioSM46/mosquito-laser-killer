      "type": "text",
      "x": 286,
      "y": 598,
      "strokeColor": "#1e1e1e",
      "text": "cuts 12 V to the laser driver  ·  GPIO 24 active-HIGH sense",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:53:41.429Z",
      "updatedAt": "2026-07-30T09:53:41.429Z",
