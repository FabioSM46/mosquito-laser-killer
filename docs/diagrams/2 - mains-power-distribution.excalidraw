    {
      "id": "title",
      "type": "text",
      "x": 40,
      "y": 24,
      "strokeColor": "#1e1e1e",
      "text": "Mains Power, Safety Contactor & DC Distribution",
      "fontSize": 30,
      "fontFamily": 1,
      "createdAt": "2026-07-30T09:57:49.475Z",
      "updatedAt": "2026-07-30T09:57:49.475Z",
      "version": 1
    },
    {
      "id": "sub1",
      "type": "text",
      "x": 40,
      "y": 66,
      "strokeColor": "#868e96",
      "text": "HARDWARE_WIRING.md §3, §4.  Mains does NOT pass through the mushroom contact — K1 switches, the mushroom breaks K1's coil circuit.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:57:49.475Z",
      "updatedAt": "2026-07-30T09:57:49.475Z",
      "version": 1
    },
    {
      "id": "sub2",
      "type": "text",
      "x": 40,
      "y": 86,
      "strokeColor": "#e03131",
      "text": "Design and inspection by a qualified person. Nothing in this drawing substitutes for that.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T09:57:49.475Z",
      "updatedAt": "2026-07-30T09:57:49.475Z",
      "version": 1
    },
    {
      "id": "phead",
