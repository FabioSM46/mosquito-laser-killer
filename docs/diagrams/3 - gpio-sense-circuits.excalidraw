    {
      "id": "ms7chivqd4h7791blov",
      "type": "text",
      "x": 40,
      "y": 66,
      "strokeColor": "#868e96",
      "text": "HARDWARE_WIRING.md §5, §6, §6a.  The filled black dots are real connections. Every leg of each divider lands on ONE junction.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:02:31.770Z",
      "updatedAt": "2026-07-30T10:02:31.770Z",
      "version": 1
    },
    {
      "id": "ms7chivq6uzxbi8fb4s",
      "type": "text",
      "x": 40,
      "y": 86,
      "strokeColor": "#e03131",
      "text": "Meter each junction with its GPIO wire DISCONNECTED, before attaching it to the Pi.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-30T10:02:31.770Z",
      "updatedAt": "2026-07-30T10:02:31.770Z",
      "version": 1
    },
